# Discord application credentials (required)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Channel & role configuration (required for bot features)
QUEUE_CHANNEL_ID=
STAFF_ROLE_ID=

# Database (SQLite by default; file stored under data/)
DATABASE_PATH=./data/scrims.db

# Queue / matchmaking settings
QUEUE_SIZE=6
MIN_ELO=
MAX_ELO=
TEAM_BALANCE_TOLERANCE=40

# Match settings
MATCH_FORMAT=best_of_3
MAP_ROTATION_MODE=unique   # "unique" avoids recently used maps, "random" for fully random

# Timers (seconds)
TIMER_TEAMCODE=300
TIMER_READY=300
TIMER_MATCH=900
TIMER_VOTE=900
TIMER_FAULT_REPORT=300

# Ranks (Elo thresholds for Bronze/Silver/Gold/Diamond/Mythic/Legendary)
RANK_BRONZE=1000
RANK_SILVER=1100
RANK_GOLD=1250
RANK_DIAMOND=1400
RANK_MYTHIC=1600
RANK_LEGENDARY=1800

# Leaderboard filters
LEADERBOARD_MIN_MATCHES=0