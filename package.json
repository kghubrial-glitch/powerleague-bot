{
  "name": "powerleague-bot",
  "version": "1.0.0",
  "description": "Brawl Stars 3v3 scrim matchmaking Discord bot (Power League inspired)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": ">=2.1.2",
    "esbuild": ">=0.25.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  }
}